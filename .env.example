# ---- Guestbook ------------------------------------------------------------
# Neon Postgres connection string (neon.tech, free tier).
# Run db/schema.sql once in the Neon SQL editor before using the guestbook.
DATABASE_URL=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app: github.com/settings/developers > New OAuth App
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- /spotify and the scrobble counter ------------------------------------
# last.fm/api/account/create — also set `lastfm` in src/lib/site.ts.
# Connect Spotify at last.fm/settings/applications so plays get scrobbled.
LASTFM_API_KEY=

# ---- Coding hours on /dashboard -------------------------------------------
# wakatime.com/settings/api-key — also set `wakatime` in src/lib/site.ts.
WAKATIME_API_KEY=

# No key needed for GitHub stats or Discord presence.
# For Discord: set `discordId` in src/lib/site.ts and join discord.gg/lanyard.
